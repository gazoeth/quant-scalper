# ─── Mode ─────────────────────────────────────────────────────────────
# Set to "testnet" (default), "paper", or "live".
# - testnet: hits Binance Futures testnet (recommended for first run)
# - paper:   no orders sent, signals only logged + recorded in SQLite
# - live:    real funds. DOUBLE-CHECK before flipping this.
QS_MODE=testnet

# ─── Binance API ──────────────────────────────────────────────────────
# Testnet keys: https://testnet.binancefuture.com/
# Live keys:    https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── Strategy ─────────────────────────────────────────────────────────
QS_TIMEFRAME=15m
QS_MTF_TIMEFRAME=1h
QS_MAX_OPEN_POSITIONS=5
QS_SCAN_INTERVAL_SECONDS=60

# Comma-separated. Anything else listed in markets becomes "altcoin".
QS_MAJOR_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,TON/USDT

QS_MAJOR_LEVERAGE=10
QS_ALT_LEVERAGE=3
QS_MAJOR_MARGIN_USDT=20
QS_ALT_MARGIN_USDT=10

# Risk (fraction of entry price)
QS_STOP_LOSS_PCT=0.008
QS_TAKE_PROFIT_PCT=0.015
QS_TRAILING_TRIGGER_PCT=0.006
QS_TRAILING_DISTANCE_PCT=0.004

# ─── Reporting ────────────────────────────────────────────────────────
# Set both to enable Telegram PnL reports. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Periodic PnL report cadence (minutes); 0 disables.
QS_PNL_REPORT_INTERVAL_MIN=60

# ─── Storage ──────────────────────────────────────────────────────────
QS_DATABASE_URL=sqlite:///data/quant_scalper.db
QS_LOG_LEVEL=INFO

# ─── Optional: outbound proxy ─────────────────────────────────────────
# Set this if your machine is geo-blocked from fapi.binance.com.
# Examples (use whichever your local Clash / V2Ray / sing-box client exposes):
#   QS_PROXY_URL=socks5h://127.0.0.1:1080
#   QS_PROXY_URL=http://127.0.0.1:7890
# HTTPS_PROXY / ALL_PROXY environment variables are also honoured.
QS_PROXY_URL=
